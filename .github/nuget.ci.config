<?xml version="1.0" encoding="utf-8"?>
<!-- CI 专用 NuGet 源：只留 nuget.org。
     本地 NuGet.config 里配了国内镜像（nuget.azure.cn），GitHub runner 上不一定通；
     CI 反而应该走官方源，避免镜像抖动导致还原失败。 -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
