<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="using:Xqd.Avalonia.Controls"
        x:Class="Xqd.Avalonia.Views.MainWindow"
        x:Name="Root"
        Title="兴趣岛视频下载器"
        Width="1180" Height="780" MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI, Microsoft YaHei, Segoe UI"
        FontSize="13"
        Foreground="{StaticResource TextBrush}"
        Background="{StaticResource BgBrush}"
        SystemDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        CanResize="True"
        PointerMoved="Window_PointerMoved"
        PointerReleased="Window_PointerReleased">

  <Grid>
    <Grid RowDefinitions="62,*,28">

      <!-- ══════════════ 顶栏 ══════════════ -->
      <!-- ★ 先给窗口三键留位置（DockPanel 按声明顺序分配空间），
           再放授权按钮，最后才是左边品牌与目录 —— 谁也别想把这几位挤出去。
           整条顶栏都可拖窗口，点品牌开「关于」，双击最大化。 -->
      <Border Grid.Row="0" Background="{StaticResource BrandGrad}"
              PointerPressed="TopBar_PointerPressed">
        <DockPanel Margin="16,0" LastChildFill="False">

          <!-- 右：窗口三键（最优先，永远贴右上角） -->
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <ctl:WindowButton Kind="Minimize" Click="BtnWinMin_Click" ToolTip.Tip="最小化" />
            <ctl:WindowButton x:Name="BtnWinMax" Kind="Maximize" Click="BtnWinMax_Click" />
            <ctl:WindowButton Kind="Close" Click="BtnWinClose_Click" ToolTip.Tip="关闭" />
          </StackPanel>

          <!-- 右：授权状态与操作 -->
          <TextBlock x:Name="LblAuth" DockPanel.Dock="Right" Text="未授权"
                     Foreground="{StaticResource TopSubBrush}" FontSize="12"
                     VerticalAlignment="Center" Margin="14,0,10,0" MaxWidth="170"
                     TextTrimming="CharacterEllipsis" />
          <Button DockPanel.Dock="Right" Classes="top" Content="重新授权" Margin="6,0,0,0"
                  Click="BtnAuth_Click" ToolTip.Tip="从 MuMu 模拟器重新读取兴趣岛 App 登录态" />
          <Button DockPanel.Dock="Right" Classes="top" Content="环境检查" Margin="6,0,0,0"
                  Click="BtnEnv_Click" ToolTip.Tip="检查 ffmpeg / ffprobe / MuMu 等运行环境" />

          <!-- 左：品牌 -->
          <Border x:Name="BrandBox" DockPanel.Dock="Left" Background="Transparent"
                  Cursor="Hand" VerticalAlignment="Center"
                  ToolTip.Tip="单击查看「关于」 · 拖动可移动窗口 · 双击最大化">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Border Width="30" Height="30" CornerRadius="8" Background="#3A7CC0">
                <TextBlock Text="岛" Foreground="White" FontSize="16" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="兴趣岛视频下载器" Foreground="White" FontSize="15" FontWeight="SemiBold" />
                <TextBlock Text="课程一键归档 · 断点续传" Foreground="{StaticResource TopSubBrush}"
                           FontSize="11" />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- 左：下载目录 -->
          <TextBlock DockPanel.Dock="Left" Text="下载目录" Foreground="{StaticResource TopSubBrush}"
                     VerticalAlignment="Center" Margin="22,0,0,0" />
          <TextBox x:Name="EdOut" DockPanel.Dock="Left" Width="230" Margin="8,0,0,0" Classes="round"
                   VerticalAlignment="Center" KeyDown="EdOut_KeyDown" LostFocus="EdOut_LostFocus"
                   ToolTip.Tip="改完回车或点别处即生效" />
          <Button DockPanel.Dock="Left" Classes="top" Content="浏览…" Margin="6,0,0,0"
                  Click="BtnBrowse_Click" />
        </DockPanel>
      </Border>

      <!-- ══════════════ 主体 ══════════════ -->
      <Grid Grid.Row="1" Margin="14,10,14,8" RowDefinitions="Auto,*">

        <!-- 提示条 -->
        <Border x:Name="Banner" Grid.Row="0" IsVisible="False" CornerRadius="8"
                Padding="12,9" Margin="0,0,0,10" BorderThickness="1">
          <TextBlock x:Name="LblBanner" TextWrapping="Wrap" FontSize="12.5" />
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="320,*">

          <!-- ── 左：我的课程（营列表） ── -->
          <Border Grid.Column="0" Classes="card" Margin="0,0,10,0">
            <Grid RowDefinitions="Auto,Auto,*,Auto">

              <DockPanel Grid.Row="0" LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="我的课程" Classes="section" />
                  <Border Background="#EEF2F8" CornerRadius="9" Padding="8,2"
                          VerticalAlignment="Center">
                    <TextBlock x:Name="LblCampCount" Text="0 个营" FontSize="11"
                               Foreground="{StaticResource MutedBrush}" />
                  </Border>
                </StackPanel>
                <Button DockPanel.Dock="Right" Content="刷新" Classes="top" Padding="10,4"
                        FontSize="12" Click="BtnRefresh_Click" />
              </DockPanel>

              <TextBox x:Name="EdCampSearch" Grid.Row="1" Classes="round" Margin="0,9,0,8"
                       Watermark="筛选营名…" TextChanged="EdCampSearch_TextChanged" />

              <Border Grid.Row="2" CornerRadius="8" BorderThickness="1"
                      BorderBrush="{StaticResource LineBrush}" ClipToBounds="True">
                <Grid RowDefinitions="Auto,*">
                  <Border Background="{StaticResource HeaderBgBrush}" Padding="10,6"
                          BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                    <CheckBox x:Name="ChkAll" Content="全选" IsThreeState="True" Click="ChkAll_Click"
                              FontSize="12" MinHeight="0" />
                  </Border>

                  <ListBox x:Name="LstCamps" Grid.Row="1" SelectionMode="Single">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <StackPanel>
                          <!-- 分组小标题（已购课程 / 公开课） -->
                          <Border IsVisible="{Binding IsHeader}" Background="{StaticResource HeaderBgBrush}"
                                  Padding="10,5" BorderBrush="{StaticResource LineBrush}"
                                  BorderThickness="0,1,0,1">
                            <Grid ColumnDefinitions="*,Auto">
                              <TextBlock Text="{Binding Header}" FontSize="11.5" FontWeight="SemiBold"
                                         Foreground="{StaticResource HeaderTextBrush}" />
                              <TextBlock Grid.Column="1" Text="{Binding HeaderCount}" FontSize="11"
                                         Foreground="{StaticResource HintBrush}" />
                            </Grid>
                          </Border>

                          <!-- 营行 -->
                          <Border IsVisible="{Binding !IsHeader}" Padding="8,0" Height="36"
                                  PointerPressed="CampRow_PointerPressed" Background="Transparent"
                                  ToolTip.Tip="{Binding Item.ToolTip}">
                            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                              <CheckBox IsChecked="{Binding Item.IsChecked, Mode=TwoWay}"
                                        VerticalAlignment="Center" Margin="0,0,8,0" MinHeight="0" />
                              <TextBlock Grid.Column="1" Text="{Binding Item.Display}" FontSize="12.5"
                                         Foreground="{StaticResource TextBrush}"
                                         TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                         ToolTip.Tip="{Binding Item.ToolTip}" />
                              <Border Grid.Column="2" Background="#F1F4F8" CornerRadius="8" Padding="7,2"
                                      VerticalAlignment="Center">
                                <TextBlock Text="{Binding Item.Badge}" FontSize="10.5"
                                           Foreground="{StaticResource MutedBrush}" />
                              </Border>
                            </Grid>
                          </Border>
                        </StackPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Grid>
              </Border>

              <TextBlock Grid.Row="3" x:Name="LblCampHint" Margin="2,8,2,0" FontSize="11"
                         Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                         Text="勾选营 → 课表自动并入右侧列表" />
            </Grid>
          </Border>

          <!-- ── 右：下载清单 / 上次下载 / 运行日志 ── -->
          <Grid Grid.Column="1" RowDefinitions="*,Auto,150">

            <Border Grid.Row="0" Classes="card" Margin="0,0,0,10">
              <Grid RowDefinitions="Auto,Auto,*,Auto">

                <!-- 第 1 行：标题 + 跑马灯 + 主操作 -->
                <DockPanel Grid.Row="0" LastChildFill="False">
                  <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <TextBlock Text="下载清单" Classes="section" />
                    <ctl:MarqueeControl x:Name="Marq" Width="200" Height="18" Margin="10,0,0,0"
                                        VerticalAlignment="Center" ClipToBounds="True"
                                        ToolTip.Tip="当前正在下载的课程" />
                  </StackPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="BtnPause" Content="暂停" MinWidth="64" Margin="6,0,0,0"
                            Click="BtnPause_Click" />
                    <Button Content="取消" Margin="6,0,0,0" Click="BtnCancel_Click" />
                    <Button x:Name="BtnRun" Classes="primary" Content="开始下载"
                            MinWidth="96" Margin="6,0,0,0" Click="BtnRun_Click"
                            ToolTip.Tip="有勾选则只下勾选的；没勾选则下清单里所有待下载的" />
                  </StackPanel>
                </DockPanel>

                <!-- 第 2 行：状态筛选 + 画质 / 扫描 / 重置 -->
                <DockPanel Grid.Row="1" LastChildFill="False" Margin="0,8,0,0">
                  <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="2">
                    <RadioButton Classes="pill" GroupName="view" Content="全部" Tag="all" IsChecked="True"
                                 Checked="View_Checked" />
                    <RadioButton Classes="pill" GroupName="view" Content="待下载" Tag="pending"
                                 Checked="View_Checked" />
                    <RadioButton Classes="pill" GroupName="view" Content="下载中" Tag="running"
                                 Checked="View_Checked" />
                    <RadioButton Classes="pill" GroupName="view" Content="已完成" Tag="done"
                                 Checked="View_Checked" />
                    <RadioButton Classes="pill" GroupName="view" Content="失败" Tag="failed"
                                 Checked="View_Checked" />
                  </StackPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ComboBox x:Name="CmbQuality" Width="112" Height="30" VerticalAlignment="Center"
                              SelectionChanged="CmbQuality_SelectionChanged">
                      <ComboBoxItem Content="最高画质" Tag="max" />
                      <ComboBoxItem Content="1080P" Tag="1080" />
                      <ComboBoxItem Content="720P" Tag="720" />
                    </ComboBox>
                    <Button Content="重新扫描" Margin="6,0,0,0" Click="BtnRescan_Click"
                            ToolTip.Tip="按磁盘上已有的成品重判状态" />
                    <Button Content="重置记录" Margin="6,0,0,0" Click="BtnReset_Click"
                            ToolTip.Tip="清空下载历史（不删成品文件）" />
                  </StackPanel>
                </DockPanel>

                <!-- 表格：表头与数据行用同样的列宽 -->
                <Border Grid.Row="2" Margin="0,10,0,0" CornerRadius="8" Background="White"
                        BorderThickness="1" BorderBrush="{StaticResource LineBrush}">
                  <Grid RowDefinitions="Auto,*">

                    <Border Grid.Row="0" Classes="thead" Padding="10,0" Height="32"
                            BorderThickness="0,0,0,1" CornerRadius="0">
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="状态" Width="80" Classes="thead" />
                        <TextBlock Text="课程" Width="{Binding $parent[Window].TitleWidth}" Classes="thead" />
                        <TextBlock x:Name="HdrCamp" Text="所属营" Width="96" Classes="thead" />
                        <TextBlock Text="时长" Width="56" Classes="thead" />
                        <TextBlock Text="大小" Width="88" TextAlignment="Right" Classes="thead" />
                        <TextBlock Text="速度" Width="68" TextAlignment="Right" Classes="thead" />
                        <TextBlock Text="剩余" Width="60" TextAlignment="Right" Classes="thead" />
                        <TextBlock Text="进度" Width="108" TextAlignment="Center" Classes="thead" />
                      </StackPanel>
                    </Border>

                    <ListBox x:Name="LstRows" Grid.Row="1" Margin="0,2,0,0" SelectionMode="Multiple"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                      <ListBox.ItemTemplate>
                        <DataTemplate>
                          <Border Height="38" Padding="10,0" Background="Transparent"
                                  PointerPressed="Row_PointerPressed" Opacity="{Binding RowOpacity}"
                                  ToolTip.Tip="{Binding ToolTip}">
                            <Border.ContextFlyout>
                              <MenuFlyout>
                                <MenuItem Header="下载该课" Click="MenuDownload_Click" />
                                <MenuItem Header="重试（清缓存后重下）" Click="MenuRetry_Click" />
                                <Separator />
                                <MenuItem Header="复制课名" Click="MenuCopy_Click" />
                                <MenuItem Header="打开所在文件夹" Click="MenuOpenFolder_Click" />
                                <MenuItem Header="删除成品（移到 _已删除）" Click="MenuDelete_Click" />
                              </MenuFlyout>
                            </Border.ContextFlyout>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                              <!-- 状态胶囊 -->
                              <Border Width="80" HorizontalAlignment="Left" VerticalAlignment="Center"
                                      Background="{Binding StatePillBg, Converter={StaticResource Hex}}"
                                      BorderBrush="{Binding StatePillBorder, Converter={StaticResource Hex}}"
                                      BorderThickness="1" CornerRadius="9" Padding="0,3">
                                <TextBlock Text="{Binding StateWord}" FontSize="11" TextAlignment="Center"
                                           Foreground="{Binding StatePillFg, Converter={StaticResource Hex}}" />
                              </Border>

                              <TextBlock Text="{Binding Title}" Width="{Binding $parent[Window].TitleWidth}"
                                         FontSize="12.5" Foreground="{StaticResource TextBrush}"
                                         VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                              <TextBlock Text="{Binding CampName}" Width="96" FontSize="11.5"
                                         Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                                         TextTrimming="CharacterEllipsis"
                                         IsVisible="{Binding $parent[Window].ShowCampColumn}" />

                              <TextBlock Text="{Binding Duration}" Width="56" FontSize="11.5"
                                         Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />

                              <TextBlock Text="{Binding Size}" Width="88" TextAlignment="Right" FontSize="11.5"
                                         Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />

                              <TextBlock Text="{Binding Speed}" Width="68" TextAlignment="Right" FontSize="11.5"
                                         Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />

                              <TextBlock Text="{Binding Eta}" Width="60" TextAlignment="Right" FontSize="11.5"
                                         Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />

                              <ctl:ProgressCell Width="108" Height="18"
                                                Value="{Binding Progress}"
                                                Fill="{Binding ProgressColor, Converter={StaticResource Hex}}" />
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </Grid>
                </Border>

                <!-- 汇总条 -->
                <Border Grid.Row="3" Background="{StaticResource HeaderBgBrush}" CornerRadius="6"
                        Padding="10,6" Margin="0,8,0,0" BorderThickness="1"
                        BorderBrush="{StaticResource LineBrush}">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock x:Name="LblSummary" FontSize="11.5" Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center" Text="暂无课程" />
                    <TextBlock x:Name="LblEta" Grid.Column="1" FontSize="11.5"
                               Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                  </Grid>
                </Border>
              </Grid>
            </Border>

            <!-- 上次下载 -->
            <Border Grid.Row="1" Classes="card" Margin="0,0,0,10" Padding="12,10">
              <Grid RowDefinitions="Auto,*">
                <DockPanel LastChildFill="False">
                  <TextBlock x:Name="LblHist" DockPanel.Dock="Left" Text="上次下载" Classes="section"
                             FontSize="12.5" />
                  <TextBlock x:Name="LblHistCount" DockPanel.Dock="Right" Text="0 条"
                             FontSize="11" Foreground="{StaticResource HintBrush}" VerticalAlignment="Center" />
                </DockPanel>
                <ListBox x:Name="LstHist" Grid.Row="1" MaxHeight="88" Margin="0,4,0,0">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Border Height="24" Padding="2,0" Background="Transparent"
                              PointerPressed="Hist_PointerPressed">
                        <Grid ColumnDefinitions="*,140,110,70">
                          <TextBlock Text="{Binding Title}" FontSize="11.5"
                                     Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="1" Text="{Binding Camp}" FontSize="11"
                                     Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="2" Text="{Binding StateWord}" FontSize="11"
                                     Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="3" Text="{Binding Size}" FontSize="11"
                                     Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                                     TextAlignment="Right" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </Border>

            <!-- 运行日志 -->
            <Border Grid.Row="2" Classes="card" Margin="0" Padding="12,10">
              <Grid RowDefinitions="Auto,*">
                <DockPanel LastChildFill="False">
                  <TextBlock DockPanel.Dock="Left" Text="运行日志" Classes="section" FontSize="12.5" />
                  <Button DockPanel.Dock="Right" Content="清空" Padding="8,3" FontSize="11.5"
                          Click="BtnClearLog_Click" />
                </DockPanel>
                <TextBox x:Name="TxtLog" Grid.Row="1" Margin="0,6,0,0" Classes="log"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto" />
              </Grid>
            </Border>
          </Grid>
        </Grid>
      </Grid>

      <!-- ══════════════ 底栏 ══════════════ -->
      <Border Grid.Row="2" Background="{StaticResource StatusBgBrush}" BorderBrush="{StaticResource LineBrush}"
              BorderThickness="0,1,0,0">
        <DockPanel Margin="14,0" LastChildFill="False">
          <TextBlock x:Name="LblVersion" DockPanel.Dock="Right" Text="v1.7.1" FontSize="11"
                     Foreground="#7C8AA0" VerticalAlignment="Center" Margin="12,0,0,0" />
          <TextBlock DockPanel.Dock="Right" Text="Ctrl+Q 退出" FontSize="11" Foreground="#7C8AA0"
                     VerticalAlignment="Center" Margin="12,0,0,0" />
          <CheckBox DockPanel.Dock="Right" x:Name="ChkAutoClose" Content="授权后关闭模拟器"
                    FontSize="11" Foreground="#6B7A8C" MinHeight="0" Margin="10,0,0,0"
                    VerticalAlignment="Center" ToolTip.Tip="读到登录态后把模拟器关掉，省内存" />
          <CheckBox DockPanel.Dock="Right" x:Name="ChkAutoLaunch" Content="授权时启动模拟器"
                    FontSize="11" Foreground="#6B7A8C" MinHeight="0" Margin="10,0,0,0"
                    VerticalAlignment="Center" ToolTip.Tip="点「重新授权」时自动启动 MuMu 模拟器" />
          <TextBlock x:Name="LblStatus" DockPanel.Dock="Left" Text="就绪" Classes="muted" />
        </DockPanel>
      </Border>
    </Grid>

    <!-- ══════════════ 缩放热区（无边框窗口必须自绘） ══════════════ -->
    <Grid ZIndex="100">
      <Border x:Name="GripLeft" Width="6" HorizontalAlignment="Left" Background="Transparent"
              PointerPressed="Grip_PointerPressed" Cursor="SizeWestEast" />
      <Border x:Name="GripRight" Width="6" HorizontalAlignment="Right" Background="Transparent"
              PointerPressed="Grip_PointerPressed" Cursor="SizeWestEast" />
      <Border x:Name="GripTop" Height="6" VerticalAlignment="Top" Background="Transparent"
              PointerPressed="Grip_PointerPressed" Cursor="SizeNorthSouth" />
      <Border x:Name="GripBottom" Height="6" VerticalAlignment="Bottom" Background="Transparent"
              PointerPressed="Grip_PointerPressed" Cursor="SizeNorthSouth" />
      <Border x:Name="GripTopLeft" Width="16" Height="16" HorizontalAlignment="Left"
              VerticalAlignment="Top" Background="Transparent" PointerPressed="Grip_PointerPressed"
              Cursor="TopLeftCorner" />
      <Border x:Name="GripTopRight" Width="16" Height="16" HorizontalAlignment="Right"
              VerticalAlignment="Top" Background="Transparent" PointerPressed="Grip_PointerPressed"
              Cursor="TopRightCorner" />
      <Border x:Name="GripBottomLeft" Width="16" Height="16" HorizontalAlignment="Left"
              VerticalAlignment="Bottom" Background="Transparent" PointerPressed="Grip_PointerPressed"
              Cursor="BottomLeftCorner" />
      <Border x:Name="GripBottomRight" Width="16" Height="16" HorizontalAlignment="Right"
              VerticalAlignment="Bottom" Background="Transparent" PointerPressed="Grip_PointerPressed"
              Cursor="BottomRightCorner" />
    </Grid>
  </Grid>
</Window>
