<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="using:Xqd.Avalonia.Controls"
        x:Class="Xqd.Avalonia.Views.MainWindow"
        x:Name="Root"
        Title="兴趣岛视频下载器"
        Width="1220" Height="800"
        MinWidth="1020" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="None"
        CanResize="True"
        Background="{StaticResource BgBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI">

  <Border x:Name="RootFrame" BorderBrush="#C9D4E2" BorderThickness="1" Background="{StaticResource BgBrush}">
    <Grid RowDefinitions="58,Auto,*,176,28">

      <!-- ═══════════════ 顶栏 ═══════════════ -->
      <Border Grid.Row="0" Background="{StaticResource BrandGrad}"
              PointerPressed="TopBar_PointerPressed"
              PointerMoved="Window_PointerMoved"
              PointerReleased="Window_PointerReleased">
        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" Margin="14,0,0,0">

          <!-- 品牌区：单击开「关于」，双击最大化，整条可拖 -->
          <Border x:Name="BrandBox" Grid.Column="0" Background="#00000000" Padding="2,0,14,0"
                  VerticalAlignment="Stretch">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
              <Border Width="30" Height="30" CornerRadius="8" Background="#3A7CC0">
                <TextBlock Text="岛" Foreground="#FFFFFF" FontSize="16" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="兴趣岛视频下载器" Foreground="{StaticResource TopFgBrush}"
                           FontSize="15" FontWeight="SemiBold" />
                <TextBlock Text="课程一键归档 · 断点续传" Foreground="{StaticResource TopSubBrush}"
                           FontSize="11" />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- 下载目录 -->
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8"
                      Margin="4,0,12,0">
            <TextBlock Text="下载到" Foreground="{StaticResource TopSubBrush}" FontSize="12"
                       VerticalAlignment="Center" />
            <TextBox x:Name="EdOut" Width="330" Height="30" FontSize="12.5"
                     KeyDown="EdOut_KeyDown" LostFocus="EdOut_LostFocus" />
            <Button Classes="top" Content="浏览…" Click="BtnBrowse_Click" />
          </StackPanel>

          <!-- 跑马灯：当前正在下的课 -->
          <ctl:MarqueeControl x:Name="Marq" Grid.Column="2" Height="20" Margin="4,0,12,0"
                              VerticalAlignment="Center" />

          <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
            <TextBlock x:Name="LblAuth" Text="未授权" Foreground="{StaticResource TopSubBrush}"
                       FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
            <Button Classes="top" Content="环境检查" Click="BtnEnv_Click" />
            <Button Classes="top" Content="重新授权" Click="BtnAuth_Click" />
            <CheckBox x:Name="ChkAutoLaunch" Content="授权时启动模拟器" Foreground="{StaticResource TopSubBrush}"
                      FontSize="11.5" IsChecked="True" VerticalAlignment="Center" />
            <CheckBox x:Name="ChkAutoClose" Content="授权后关闭模拟器" Foreground="{StaticResource TopSubBrush}"
                      FontSize="11.5" IsChecked="True" VerticalAlignment="Center" />
          </StackPanel>

          <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Top">
            <Button Classes="win" Content="—" Click="BtnWinMin_Click" />
            <Button Classes="win" x:Name="BtnWinMax" Content="□" Click="BtnWinMax_Click" />
            <Button Classes="win close" Content="✕" Click="BtnWinClose_Click" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- ═══════════════ 提示条 ═══════════════ -->
      <Border x:Name="Banner" Grid.Row="1" IsVisible="False" Margin="14,10,14,0" Padding="12,8"
              CornerRadius="6" BorderThickness="1"
              Background="#E8F1FB" BorderBrush="#B9D4EF">
        <Grid ColumnDefinitions="Auto,*">
          <TextBlock x:Name="LblBanner" Grid.Column="1" TextWrapping="Wrap" FontSize="12.5"
                     Foreground="#185FA5" VerticalAlignment="Center" />
        </Grid>
      </Border>

      <!-- ═══════════════ 主体：左营列表 + 右单表 ═══════════════ -->
      <Grid Grid.Row="2" ColumnDefinitions="330,*" Margin="14,10,14,0">

        <!-- 左：营列表 -->
        <Border Grid.Column="0" Background="{StaticResource CardBrush}" CornerRadius="10"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Margin="0,0,10,0">
          <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="10">

            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="2,2,2,8">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="我的课程" FontSize="13.5" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                <Border Background="#EDF2F8" CornerRadius="9" Padding="8,2">
                  <TextBlock x:Name="LblCampCount" Text="0 个营" FontSize="11"
                             Foreground="{StaticResource MutedBrush}" />
                </Border>
              </StackPanel>
              <Button Grid.Column="1" Content="刷新" Click="BtnRefresh_Click" Height="28" Padding="10,3" />
            </Grid>

            <TextBox x:Name="EdCampSearch" Grid.Row="1" Watermark="筛选营名…" Height="30"
                     TextChanged="EdCampSearch_TextChanged" Margin="0,0,0,8" />

            <Border Grid.Row="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                    CornerRadius="8" ClipToBounds="True">
              <Grid RowDefinitions="Auto,*">
                <Border Background="#F7F9FC" Padding="10,7" BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="0,0,0,1">
                  <CheckBox x:Name="ChkAll" Content="全选" IsThreeState="True" Click="ChkAll_Click"
                            FontSize="12" />
                </Border>

                <ListBox x:Name="LstCamps" Grid.Row="1" SelectionMode="Single">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <StackPanel>
                        <!-- 分组小标题（已购课程 / 公开课） -->
                        <Border IsVisible="{Binding IsHeader}" Background="#F7F9FC" Padding="10,6"
                                BorderBrush="#E6EBF2" BorderThickness="0,1,0,1">
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding Header}" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource MutedBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding HeaderCount}" FontSize="11"
                                       Foreground="#9AA9BA" />
                          </Grid>
                        </Border>

                        <!-- 营行 -->
                        <Border IsVisible="{Binding !IsHeader}" Padding="8,0" Height="36"
                                PointerPressed="CampRow_PointerPressed" Background="#00000000">
                          <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                            <CheckBox IsChecked="{Binding Item.IsChecked, Mode=TwoWay}"
                                      VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Grid.Column="1" Text="{Binding Item.Display}" FontSize="12.5"
                                       Foreground="{StaticResource TextBrush}"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                       ToolTip.Tip="{Binding Item.ToolTip}" />
                            <Border Grid.Column="2" Background="#F1F4F8" CornerRadius="8" Padding="7,2"
                                    VerticalAlignment="Center">
                              <TextBlock Text="{Binding Item.Badge}" FontSize="10.5"
                                         Foreground="{StaticResource MutedBrush}" />
                            </Border>
                          </Grid>
                        </Border>
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </Border>

            <TextBlock Grid.Row="3" x:Name="LblCampHint" Margin="2,7,2,0" FontSize="11"
                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                       Text="勾选营 → 课表自动并入右侧列表" />
          </Grid>
        </Border>

        <!-- 右：单表 -->
        <Border Grid.Column="1" Background="{StaticResource CardBrush}" CornerRadius="10"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
          <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Margin="12,10,12,8">

            <!-- 工具条 -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,8">
              <StackPanel Orientation="Horizontal" Spacing="2">
                <RadioButton Classes="tab" GroupName="view" Content="全部" Tag="all" IsChecked="True"
                             Checked="View_Checked" />
                <RadioButton Classes="tab" GroupName="view" Content="待下载" Tag="pending" Checked="View_Checked" />
                <RadioButton Classes="tab" GroupName="view" Content="下载中" Tag="running" Checked="View_Checked" />
                <RadioButton Classes="tab" GroupName="view" Content="已完成" Tag="done" Checked="View_Checked" />
                <RadioButton Classes="tab" GroupName="view" Content="失败" Tag="failed" Checked="View_Checked" />
              </StackPanel>

              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                <ComboBox x:Name="CmbQuality" Width="112" Height="30" SelectionChanged="CmbQuality_SelectionChanged">
                  <ComboBoxItem Content="最高画质" Tag="max" />
                  <ComboBoxItem Content="1080P" Tag="1080" />
                  <ComboBoxItem Content="720P" Tag="720" />
                </ComboBox>
                <Button Content="重新扫描" Click="BtnRescan_Click" ToolTip.Tip="按磁盘上已有的成品重判状态" />
                <Button Content="重置记录" Click="BtnReset_Click" ToolTip.Tip="清空下载历史（不删成品文件）" />
                <Button x:Name="BtnPause" Content="暂停" Click="BtnPause_Click" MinWidth="64" />
                <Button Content="取消" Click="BtnCancel_Click" />
                <Button x:Name="BtnRun" Classes="primary" Content="开始下载" Click="BtnRun_Click" MinWidth="96" />
              </StackPanel>
            </Grid>

            <!-- 表头 -->
            <Border Grid.Row="1" Background="#F7F9FC" CornerRadius="8" BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1" Padding="10,0" Height="32">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="状态" Width="92" FontSize="11.5" FontWeight="SemiBold"
                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                <TextBlock Text="课程" Width="{Binding TitleWidth}" FontSize="11.5" FontWeight="SemiBold"
                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="HdrCamp" Text="所属营" Width="120" FontSize="11.5" FontWeight="SemiBold"
                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                <TextBlock Text="时长" Width="66" FontSize="11.5" FontWeight="SemiBold"
                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                <TextBlock Text="大小" Width="112" TextAlignment="Right" FontSize="11.5" FontWeight="SemiBold"
                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                <TextBlock Text="速度" Width="78" TextAlignment="Right" FontSize="11.5" FontWeight="SemiBold"
                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                <TextBlock Text="剩余" Width="78" TextAlignment="Right" FontSize="11.5" FontWeight="SemiBold"
                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                <TextBlock Text="进度" Width="150" FontSize="11.5" FontWeight="SemiBold"
                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
              </StackPanel>
            </Border>

            <!-- 数据行 -->
            <ListBox x:Name="LstRows" Grid.Row="2" Margin="0,4,0,0" SelectionMode="Multiple">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Height="38" Padding="10,0" Background="#00000000"
                          PointerPressed="Row_PointerPressed" Opacity="{Binding RowOpacity}"
                          ToolTip.Tip="{Binding ToolTip}">
                    <Border.ContextFlyout>
                      <MenuFlyout>
                        <MenuItem Header="下载该课" Click="MenuDownload_Click" />
                        <MenuItem Header="重试（清缓存后重下）" Click="MenuRetry_Click" />
                        <Separator />
                        <MenuItem Header="复制课名" Click="MenuCopy_Click" />
                        <MenuItem Header="打开所在文件夹" Click="MenuOpenFolder_Click" />
                        <MenuItem Header="删除成品（移到 _已删除）" Click="MenuDelete_Click" />
                      </MenuFlyout>
                    </Border.ContextFlyout>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <!-- 状态胶囊 -->
                      <Border Width="92" HorizontalAlignment="Left" VerticalAlignment="Center"
                              Background="{Binding StatePillBg, Converter={StaticResource Hex}}"
                              BorderBrush="{Binding StatePillBorder, Converter={StaticResource Hex}}"
                              BorderThickness="1" CornerRadius="9" Padding="0,3" Margin="0,0,0,0">
                        <TextBlock Text="{Binding StateWord}" FontSize="11" TextAlignment="Center"
                                   Foreground="{Binding StatePillFg, Converter={StaticResource Hex}}" />
                      </Border>

                      <TextBlock Text="{Binding Title}" Width="{Binding $parent[Window].TitleWidth}"
                                 FontSize="12.5" Foreground="{StaticResource TextBrush}"
                                 VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                 Margin="0,0,0,0" />

                      <TextBlock Text="{Binding CampName}" Width="120" FontSize="11.5"
                                 Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis"
                                 IsVisible="{Binding $parent[Window].ShowCampColumn}" />

                      <TextBlock Text="{Binding Duration}" Width="66" FontSize="11.5"
                                 Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />

                      <TextBlock Text="{Binding Size}" Width="112" TextAlignment="Right" FontSize="11.5"
                                 Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />

                      <TextBlock Text="{Binding Speed}" Width="78" TextAlignment="Right" FontSize="11.5"
                                 Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />

                      <TextBlock Text="{Binding Eta}" Width="78" TextAlignment="Right" FontSize="11.5"
                                 Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />

                      <ctl:ProgressCell Width="150" Height="18" Margin="0,0,0,0"
                                        Value="{Binding Progress}"
                                        Fill="{Binding ProgressColor, Converter={StaticResource Hex}}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <!-- 汇总条 -->
            <Border Grid.Row="3" Background="#F7F9FC" CornerRadius="6" Padding="10,6" Margin="0,6,0,0"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock x:Name="LblSummary" FontSize="11.5" Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center" Text="暂无课程" />
                <TextBlock x:Name="LblEta" Grid.Column="1" FontSize="11.5"
                           Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
              </Grid>
            </Border>

            <!-- 上次下载（历史带） -->
            <Border Grid.Row="4" Margin="0,8,0,0" BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1,0,0,0" Padding="0,6,0,0">
              <Grid RowDefinitions="Auto,*">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock x:Name="LblHist" Text="上次下载" FontSize="11.5" FontWeight="SemiBold"
                             Foreground="{StaticResource MutedBrush}" />
                  <TextBlock Grid.Column="1" x:Name="LblHistCount" Text="0 条" FontSize="11"
                             Foreground="#9AA9BA" />
                </Grid>
                <ListBox x:Name="LstHist" Grid.Row="1" MaxHeight="92" Margin="0,4,0,0">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Border Height="24" Padding="2,0" PointerPressed="Hist_PointerPressed">
                        <Grid ColumnDefinitions="*,140,110,70">
                          <TextBlock Text="{Binding Title}" FontSize="11.5"
                                     Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="1" Text="{Binding Camp}" FontSize="11"
                                     Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="2" Text="{Binding StateWord}" FontSize="11"
                                     Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="3" Text="{Binding Size}" FontSize="11"
                                     Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                                     TextAlignment="Right" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </Border>
          </Grid>
        </Border>
      </Grid>

      <!-- ═══════════════ 日志 ═══════════════ -->
      <Border Grid.Row="3" Background="{StaticResource CardBrush}" CornerRadius="10" Margin="14,10,14,0"
              BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
        <Grid RowDefinitions="Auto,*">
          <Grid ColumnDefinitions="*,Auto" Margin="12,8,10,0">
            <TextBlock Text="运行日志" FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="清空" Height="24" Padding="8,2" FontSize="11.5"
                    Click="BtnClearLog_Click" />
          </Grid>
          <TextBox x:Name="TxtLog" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True"
                   FontFamily="Cascadia Mono, Consolas, monospace" FontSize="11.5"
                   Background="#00000000" BorderThickness="0" Padding="12,4,8,8"
                   TextWrapping="NoWrap"
                   ScrollViewer.VerticalScrollBarVisibility="Auto"
                   ScrollViewer.HorizontalScrollBarVisibility="Auto" />
        </Grid>
      </Border>

      <!-- ═══════════════ 状态栏 ═══════════════ -->
      <Grid Grid.Row="4" ColumnDefinitions="Auto,*,Auto" Margin="18,0">
        <TextBlock x:Name="LblVersion" FontSize="11" Foreground="#8A97A8" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" x:Name="LblStatus" FontSize="11" Foreground="#8A97A8"
                   VerticalAlignment="Center" Margin="16,0,0,0" />
        <TextBlock Grid.Column="2" Text="Ctrl+Q 退出" FontSize="11" Foreground="#A5B1C0"
                   VerticalAlignment="Center" />
      </Grid>

      <!-- 缩放热区（无边框窗口必须自绘；铺满整窗，只在小边上响应） -->
      <Grid Grid.Row="0" Grid.RowSpan="5">
        <Border x:Name="GripLeft" Width="5" HorizontalAlignment="Left" Background="#00000000"
                PointerPressed="Grip_PointerPressed" Cursor="SizeWestEast" />
        <Border x:Name="GripRight" Width="5" HorizontalAlignment="Right" Background="#00000000"
                PointerPressed="Grip_PointerPressed" Cursor="SizeWestEast" />
        <Border x:Name="GripTop" Height="5" VerticalAlignment="Top" Background="#00000000"
                PointerPressed="Grip_PointerPressed" Cursor="SizeNorthSouth" />
        <Border x:Name="GripBottom" Height="5" VerticalAlignment="Bottom" Background="#00000000"
                PointerPressed="Grip_PointerPressed" Cursor="SizeNorthSouth" />
        <Border x:Name="GripTopLeft" Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Top"
                Background="#00000000" PointerPressed="Grip_PointerPressed" Cursor="TopLeftCorner" />
        <Border x:Name="GripTopRight" Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Top"
                Background="#00000000" PointerPressed="Grip_PointerPressed" Cursor="TopRightCorner" />
        <Border x:Name="GripBottomLeft" Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Background="#00000000" PointerPressed="Grip_PointerPressed" Cursor="BottomLeftCorner" />
        <Border x:Name="GripBottomRight" Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Background="#00000000" PointerPressed="Grip_PointerPressed" Cursor="BottomRightCorner" />
      </Grid>
    </Grid>
  </Border>
</Window>
