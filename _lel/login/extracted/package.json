{
  "author": "学无止科技",
  "name": "login-mooc",
  "version": "1.0.0",
  "main": "main.js",
  "devDependencies": {
    "electron": "8.5.5",
    "electron-builder": "^22.14.13"
  },
  "scripts": {
    "postinstall": "install-electron",
    "start": "electron . cookies icourse163",
    "build:slim-safe": "electron-builder -w --config electron-builder.slim-safe.json",
    "pack": "cmd /c ..\\pack-login.bat"
