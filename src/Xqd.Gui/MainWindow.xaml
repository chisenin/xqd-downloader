<Window x:Class="Xqd.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:Xqd.Gui.Controls"
        Title="兴趣岛视频下载器  v1.5.1"
        Width="1220" Height="800" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI, Microsoft YaHei, Segoe UI, sans-serif"
        FontSize="13"
        Foreground="{StaticResource TextDarkBrush}"
        Background="{StaticResource AppBgBrush}"
        PreviewKeyDown="Window_PreviewKeyDown"
        SizeChanged="Window_SizeChanged">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══════════════ 顶栏：蓝色渐变品牌区（无原生菜单栏） ══════════════ -->
        <Border Grid.Row="0" Height="62" Background="{StaticResource BrandGradient}">
            <DockPanel Margin="18,8,18,8" LastChildFill="False">
                <!-- 品牌区：点任意位置弹「使用说明与关于」 -->
                <Border x:Name="BrandBox" DockPanel.Dock="Left" Background="Transparent"
                        Cursor="Hand" ToolTip="点击查看使用说明与关于本工具"
                        VerticalAlignment="Center"
                        MouseLeftButtonDown="BrandBox_MouseLeftButtonDown">
                    <StackPanel>
                        <TextBlock Text="兴趣岛视频下载器" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock Text="批量导出课程视频为通用 MP4" FontSize="11"
                                   Foreground="{StaticResource BrandSubBrush}"/>
                    </StackPanel>
                </Border>

                <TextBlock DockPanel.Dock="Left" Text="下载目录" Foreground="White"
                           VerticalAlignment="Center" Margin="24,0,0,0"/>
                <TextBox x:Name="EdOut" DockPanel.Dock="Left" Width="260" Margin="8,0,0,0"
                         Style="{StaticResource RoundTextBoxStyle}"
                         KeyDown="EdOut_KeyDown" VerticalAlignment="Center"/>
                <Button x:Name="BtnBrowse" DockPanel.Dock="Left" Content="浏览…" Margin="6,0,0,0"
                        Style="{StaticResource ModernButtonStyle}" Click="BtnBrowse_Click"/>

                <Button x:Name="BtnRetry" DockPanel.Dock="Right" Content="重新授权"
                        Style="{StaticResource ModernButtonStyle}" Click="BtnRetry_Click"
                        ToolTip="从 MuMu 模拟器重新读取兴趣岛登录态并刷新本机保存的授权。&#x0a;平时启动工具直接用已保存的授权，不会启动模拟器。"/>
                <TextBlock x:Name="LblAuth" DockPanel.Dock="Right" Text="授权：检查中…"
                           Foreground="{StaticResource BrandSubBrush}" VerticalAlignment="Center"
                           Margin="14,0"/>
                <CheckBox x:Name="ChkAutoClose" DockPanel.Dock="Right" Content="授权后自动关闭"
                          Foreground="White" VerticalAlignment="Center" Margin="14,0,0,0"
                          IsChecked="True"
                          ToolTip="仅在真正走了模拟器授权时生效：拿到授权后自动关闭兴趣岛 App 与安卓设备"/>
                <CheckBox x:Name="ChkAutoLaunch" DockPanel.Dock="Right" Content="自动启动 MuMu"
                          Foreground="White" VerticalAlignment="Center" Margin="14,0,0,0"
                          IsChecked="True"
                          ToolTip="仅在「本机还没有保存授权」或点「重新授权」时才生效。&#x0a;平时启动工具直接用已保存的授权，不会启动模拟器。"/>
            </DockPanel>
        </Border>

        <!-- ══════════════ 主体 ══════════════ -->
        <Grid Grid.Row="1" Margin="14,12,14,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 授权提示条 -->
            <Border x:Name="Banner" Grid.Row="0" Visibility="Collapsed" CornerRadius="8"
                    Padding="12,9" Margin="0,0,0,10" BorderThickness="1"
                    Background="{StaticResource BannerInfoBg}"
                    BorderBrush="{StaticResource BannerInfoBd}">
                <TextBlock x:Name="TxtBanner" TextWrapping="Wrap"
                           Foreground="{StaticResource BannerInfoFg}"/>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ── 左栏：营列表 ── -->
                <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,10,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" LastChildFill="False">
                            <TextBlock Text="营列表" Style="{StaticResource SectionTitleStyle}"/>
                            <CheckBox x:Name="ChkAllCamps" DockPanel.Dock="Right" Content="全选"
                                      IsThreeState="True" VerticalAlignment="Center"
                                      ToolTip="勾选全部营，把它们的课程一起加进课程列表；再点一次取消全部"
                                      Click="ChkAllCamps_Click"/>
                        </DockPanel>

                        <ListBox x:Name="TabList" Grid.Row="1" Margin="0,8,0,6"
                                 BorderThickness="0" Background="Transparent"
                                 ItemContainerStyle="{StaticResource PillTabItemStyle}"
                                 SelectionChanged="TabList_SelectionChanged">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>

                        <ListBox x:Name="LstCamps" Grid.Row="2"
                                 BorderThickness="0" Background="Transparent"
                                 ItemContainerStyle="{StaticResource CampListItemStyle}"
                                 SelectionChanged="LstCamps_SelectionChanged"
                                 PreviewMouseLeftButtonUp="LstCamps_PreviewMouseUp">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel ToolTip="{Binding ToolTip}" Background="Transparent">
                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                  VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Display}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <DockPanel Grid.Row="3" Margin="0,8,0,0" LastChildFill="False">
                            <Button x:Name="BtnRefreshCamps" DockPanel.Dock="Left" Content="刷新"
                                    Style="{StaticResource ModernButtonStyle}"
                                    Click="BtnRefreshCamps_Click"/>
                            <TextBlock x:Name="LblCampHint" DockPanel.Dock="Left" Margin="10,0,0,0"
                                       Style="{StaticResource MutedTextStyle}" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </Grid>
                </Border>

                <!-- ── 右栏：课程列表 / 下载管理 / 运行日志 ── -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="210"/>
                        <RowDefinition Height="180"/>
                    </Grid.RowDefinitions>

                    <!-- 课程列表 -->
                    <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" LastChildFill="False">
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                    <TextBlock Text="课程列表 ·" Style="{StaticResource SectionTitleStyle}"/>
                                    <ctrl:MarqueeControl x:Name="Marquee" Margin="4,0,0,0"/>
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <ComboBox x:Name="CmbQuality" Width="128" Margin="3,0,0,0"
                                              VerticalAlignment="Center"
                                              SelectionChanged="CmbQuality_SelectionChanged">
                                        <ComboBoxItem Content="最高画质 (1080p)" Tag="max"/>
                                        <ComboBoxItem Content="省流量 (720p)" Tag="720"/>
                                    </ComboBox>
                                    <Button x:Name="BtnAll" Content="全选" Margin="3,0,0,0"
                                            Style="{StaticResource ModernButtonStyle}" Click="BtnAll_Click"/>
                                    <Button x:Name="BtnNone" Content="清空" Margin="3,0,0,0"
                                            Style="{StaticResource ModernButtonStyle}" Click="BtnNone_Click"/>
                                    <Button x:Name="BtnRescan" Content="重新检测" Margin="3,0,0,0"
                                            Style="{StaticResource ModernButtonStyle}" Click="BtnRescan_Click"
                                            ToolTip="重新扫描下载目录，标记哪些课已经下过了"/>
                                    <Button x:Name="BtnDownload" Content="下载选中" Margin="3,0,0,0"
                                            Style="{StaticResource PrimaryButtonStyle}" Click="BtnDownload_Click"/>
                                    <Button x:Name="BtnPause" Content="暂停" Margin="3,0,0,0"
                                            Style="{StaticResource PauseButtonStyle}" Click="BtnPause_Click"
                                            IsEnabled="False"
                                            ToolTip="暂停所有正在进行的下载（已下好的分片会保留，点「继续」接着下）"/>
                                    <Button x:Name="BtnDownloadOne" Content="下载此课" Margin="3,0,0,0"
                                            Style="{StaticResource ModernButtonStyle}" Click="BtnDownloadOne_Click"
                                            ToolTip="只下载当前选中的一节课"/>
                                </StackPanel>
                            </DockPanel>

                            <Border Grid.Row="1" Margin="0,8,0,0" CornerRadius="8" Background="White"
                                    BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                                <ListView x:Name="LstLessons" BorderThickness="0" Background="Transparent"
                                          AlternationCount="2"
                                          ItemContainerStyle="{StaticResource GridListItemStyle}"
                                          SelectionMode="Single"
                                          MouseDoubleClick="LstLessons_MouseDoubleClick">
                                    <ListView.View>
                                        <GridView ColumnHeaderContainerStyle="{StaticResource GridHeaderStyle}">
                                            <!-- ColCheck -->
                                            <GridViewColumn Width="34">
                                                <GridViewColumn.Header>
                                                    <CheckBox IsThreeState="True" HorizontalAlignment="Center"
                                                              ToolTip="全选 / 全不选"/>
                                                </GridViewColumn.Header>
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                                  HorizontalAlignment="Center"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <!-- ColPrefix -->
                                            <GridViewColumn Width="74" Header="标题前缀">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Prefix}" HorizontalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <!-- ColTitle：课名 + 紧跟其后的独立配色状态词 -->
                                            <GridViewColumn Width="360" Header="课程">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" ToolTip="{Binding ToolTip}">
                                                            <TextBlock Text="{Binding Title}"
                                                                       Foreground="{StaticResource TextDarkBrush}"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding StateSuffix}"
                                                                       Foreground="{Binding StateWord, Converter={StaticResource StateColorConverter}}"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <!-- ColSuffix -->
                                            <GridViewColumn Width="96" Header="标题后缀">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Suffix}" ToolTip="{Binding ToolTip}"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <!-- ColDur -->
                                            <GridViewColumn Width="76" Header="时长">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Duration}" HorizontalAlignment="Center"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <!-- ColProgress -->
                                            <GridViewColumn Width="150" Header="进度">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <ProgressBar Value="{Binding Progress}"
                                                                     Style="{StaticResource CellProgressStyle}"
                                                                     ToolTip="{Binding ProgressTip}"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </Border>

                            <TextBlock x:Name="LblExist" Grid.Row="2" Margin="2,6,0,0"
                                       Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
                            <TextBlock x:Name="LblLessonsHint" Grid.Row="3" Margin="2,2,0,0"
                                       Style="{StaticResource MutedTextStyle}" Text="选择左侧营查看课程"
                                       TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Border>

                    <!-- 下载管理 -->
                    <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" LastChildFill="False">
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                    <TextBlock Text="下载管理" Style="{StaticResource SectionTitleStyle}"/>
                                    <TextBlock x:Name="LblTaskEta" Margin="14,0,0,0"
                                               Foreground="{StaticResource PrimaryBrush}"
                                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button x:Name="BtnClearList" Content="清除列表" Margin="3,0,0,0"
                                            Style="{StaticResource ModernButtonStyle}" Click="BtnClearList_Click"
                                            ToolTip="只清任务表与历史记录，不动已下载的文件"/>
                                    <Button x:Name="BtnDeleteFiles" Content="删除文件" Margin="3,0,0,0"
                                            Style="{StaticResource DangerButtonStyle}" Click="BtnDeleteFiles_Click"
                                            ToolTip="把选中任务对应的成品移到「_已删除」子目录"/>
                                </StackPanel>
                            </DockPanel>

                            <Border Grid.Row="1" Margin="0,8,0,0" CornerRadius="8" Background="White"
                                    BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                                <ListView x:Name="LstTasks" BorderThickness="0" Background="Transparent"
                                          AlternationCount="2" SelectionMode="Extended"
                                          ItemContainerStyle="{StaticResource GridListItemStyle}">
                                    <ListView.View>
                                        <GridView ColumnHeaderContainerStyle="{StaticResource GridHeaderStyle}">
                                            <!-- TaskColState：状态词独立配色 -->
                                            <GridViewColumn Width="96" Header="状态">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding StateWord}"
                                                                   Foreground="{Binding StateWord, Converter={StaticResource StateColorConverter}}"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <!-- TaskColTitle -->
                                            <GridViewColumn Width="260" Header="课名">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Title}" ToolTip="{Binding ToolTip}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <!-- TaskColSize -->
                                            <GridViewColumn Width="112" Header="大小">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Size}" HorizontalAlignment="Right"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <!-- TaskColSpeed -->
                                            <GridViewColumn Width="78" Header="速度">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Speed}" HorizontalAlignment="Right"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <!-- TaskColEta -->
                                            <GridViewColumn Width="88" Header="剩余时间">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Eta}" HorizontalAlignment="Right"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <!-- TaskColProgress -->
                                            <GridViewColumn Width="150" Header="进度">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <ProgressBar Value="{Binding Progress}"
                                                                     Style="{StaticResource CellProgressStyle}"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- 运行日志 -->
                    <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" LastChildFill="False">
                                <TextBlock Text="运行日志" Style="{StaticResource SectionTitleStyle}"/>
                                <Button x:Name="BtnClearLog" DockPanel.Dock="Right" Content="清空日志"
                                        Style="{StaticResource ModernButtonStyle}" Click="BtnClearLog_Click"/>
                            </DockPanel>
                            <Border Grid.Row="1" Margin="0,6,0,0" CornerRadius="6"
                                    Background="{StaticResource LogBgBrush}">
                                <TextBox x:Name="TxtLog" Style="{StaticResource LogTextBoxStyle}"
                                         Background="Transparent" BorderThickness="0"/>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- ══════════════ 状态栏 ══════════════ -->
        <Border Grid.Row="2" Background="{StaticResource StatusBgBrush}" Padding="12,4">
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="StatusLabel" Text="就绪" Foreground="{StaticResource HeaderTextBrush}"/>
                <TextBlock x:Name="LblVersion" DockPanel.Dock="Right" Text="兴趣岛 · 1.5.1"
                           Foreground="{StaticResource MutedBrush}"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
