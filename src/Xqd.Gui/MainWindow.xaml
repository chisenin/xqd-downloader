<Window x:Class="Xqd.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:Xqd.Gui.Controls;assembly=Xqd.Controls"
        Title="兴趣岛视频下载器  v1.5.1"
        Width="1220" Height="800" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI, Microsoft YaHei, Segoe UI, sans-serif"
        FontSize="13"
        Foreground="{StaticResource TextDarkBrush}"
        Background="{StaticResource AppBgBrush}"
        PreviewKeyDown="Window_PreviewKeyDown"
        SizeChanged="Window_SizeChanged"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowDrop="True">

    <!-- ★ v1.5.4：去掉 Windows 原生标题栏，改用自绘窗口按钮。
         WindowChrome 保留 DWM 阴影与可拖拽的缩放边缘；
         CaptionHeight=0 表示"这一行不是系统标题栏"，但左上角仍保留系统菜单。 -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══════════════ 顶栏：蓝色渐变品牌区（无原生菜单栏） ══════════════ -->
        <Border Grid.Row="0" Height="62" Background="{StaticResource BrandGradient}">
            <DockPanel Margin="18,8,18,8" LastChildFill="False">
                <!-- ★ v1.5.4：logo 区可拖动窗口 + 双击最大化。
                     左键单击（未拖动）仍然打开「使用说明与关于」，
                     拖动与单击靠 5px 位移阈值区分（见 BrandBox_MouseLeftButtonDown）。
                     ★ Border 没有 MouseDoubleClick 事件 —— 双击靠
                     MouseLeftButtonDown 的 e.ClickCount >= 2 判断。 -->
                <Border x:Name="BrandBox" DockPanel.Dock="Left" Background="Transparent"
                        Cursor="Hand" ToolTip="点击查看使用说明与关于本工具 · 拖动可移动窗口 · 双击最大化"
                        VerticalAlignment="Center"
                        MouseLeftButtonDown="BrandBox_MouseLeftButtonDown"
                        MouseLeftButtonUp="BrandBox_MouseLeftButtonUp"
                        MouseMove="BrandBox_MouseMove">
                    <StackPanel>
                        <TextBlock Text="兴趣岛视频下载器" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock Text="批量导出课程视频为通用 MP4" FontSize="11"
                                   Foreground="{StaticResource BrandSubBrush}"/>
                    </StackPanel>
                </Border>

                <TextBlock DockPanel.Dock="Left" Text="下载目录" Foreground="White"
                           VerticalAlignment="Center" Margin="24,0,0,0"/>
                <TextBox x:Name="EdOut" DockPanel.Dock="Left" Width="260" Margin="8,0,0,0"
                         Style="{StaticResource RoundTextBoxStyle}"
                         KeyDown="EdOut_KeyDown" VerticalAlignment="Center"/>
                <Button x:Name="BtnBrowse" DockPanel.Dock="Left" Content="浏览…" Margin="6,0,0,0"
                        Style="{StaticResource ModernButtonStyle}" Click="BtnBrowse_Click"/>

                <!-- ★ v1.5.4：自绘窗口按钮组（最小化 / 最大化-还原 / 关闭） -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Stretch"
                            Margin="0,0,-18,0">
                    <ctrl:WindowButton x:Name="BtnWinMin" ButtonKind="Minimize" Click="BtnWinMin_Click"/>
                    <ctrl:WindowButton x:Name="BtnWinMax" ButtonKind="Maximize" Click="BtnWinMax_Click"/>
                    <ctrl:WindowButton x:Name="BtnWinClose" ButtonKind="Close" Click="BtnWinClose_Click"/>
                </StackPanel>

                <Button x:Name="BtnEnv" DockPanel.Dock="Right" Content="环境检查"
                        Style="{StaticResource ModernButtonStyle}" Click="BtnEnv_Click"
                        ToolTip="检查 ffmpeg / ffprobe 等运行环境依赖。&#x0a;缺失时可一键自动下载安装（国内镜像优先）。"/>
                <Button x:Name="BtnRetry" DockPanel.Dock="Right" Content="重新授权"
                        Style="{StaticResource ModernButtonStyle}" Click="BtnRetry_Click"
                        ToolTip="从 MuMu 模拟器重新读取兴趣岛登录态并刷新本机保存的授权。&#x0a;平时启动工具直接用已保存的授权，不会启动模拟器。"/>
                <TextBlock x:Name="LblAuth" DockPanel.Dock="Right" Text="授权：检查中…"
                           Foreground="{StaticResource BrandSubBrush}" VerticalAlignment="Center"
                           Margin="14,0"/>
                <CheckBox x:Name="ChkAutoClose" DockPanel.Dock="Right" Content="授权后自动关闭"
                          Foreground="White" VerticalAlignment="Center" Margin="14,0,0,0"
                          IsChecked="True"
                          ToolTip="仅在真正走了模拟器授权时生效：拿到授权后自动关闭兴趣岛 App 与安卓设备"/>
                <CheckBox x:Name="ChkAutoLaunch" DockPanel.Dock="Right" Content="自动启动 MuMu"
                          Foreground="White" VerticalAlignment="Center" Margin="14,0,0,0"
                          IsChecked="True"
                          ToolTip="仅在「本机还没有保存授权」或点「重新授权」时才生效。&#x0a;平时启动工具直接用已保存的授权，不会启动模拟器。"/>
            </DockPanel>
        </Border>

        <!-- ══════════════ 主体 ══════════════ -->
        <Grid Grid.Row="1" Margin="14,12,14,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 授权提示条 -->
            <Border x:Name="Banner" Grid.Row="0" Visibility="Collapsed" CornerRadius="8"
                    Padding="12,9" Margin="0,0,0,10" BorderThickness="1"
                    Background="{StaticResource BannerInfoBg}"
                    BorderBrush="{StaticResource BannerInfoBd}">
                <TextBlock x:Name="TxtBanner" TextWrapping="Wrap"
                           Foreground="{StaticResource BannerInfoFg}"/>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ── 左栏：营列表 ── -->
                <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,10,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" LastChildFill="False">
                            <TextBlock Text="营列表" Style="{StaticResource SectionTitleStyle}"/>
                            <CheckBox x:Name="ChkAllCamps" DockPanel.Dock="Right" Content="全选"
                                      IsThreeState="True" VerticalAlignment="Center"
                                      ToolTip="勾选全部营，把它们的课程一起加进课程列表；再点一次取消全部"
                                      Click="ChkAllCamps_Click"/>
                        </DockPanel>

                        <!-- ★ v1.6.2：去掉「全部/正式营/体验营/轻课」这种固定分类表头 ——
                             营名本身就是最好的分类（摄影课、美容课…直接列出来）。
                             26 个营需要搜索，所以顶部放搜索框。 -->
                        <Grid Grid.Row="1" Margin="0,8,0,6">
                            <TextBox x:Name="EdCampSearch" Style="{StaticResource RoundTextBoxStyle}"
                                     TextChanged="EdCampSearch_TextChanged"
                                     ToolTip="按营名筛选（留空 = 显示全部）"/>
                            <TextBlock Text="搜索营名…" IsHitTestVisible="False"
                                       VerticalAlignment="Center" Margin="9,0,0,0"
                                       Foreground="#A8B2C1">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=EdCampSearch}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <ListBox x:Name="LstCamps" Grid.Row="2"
                                 BorderThickness="0" Background="Transparent"
                                 ItemContainerStyle="{StaticResource CampListItemStyle}"
                                 SelectionChanged="LstCamps_SelectionChanged"
                                 PreviewMouseLeftButtonUp="LstCamps_PreviewMouseUp">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel ToolTip="{Binding ToolTip}" Background="Transparent">
                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                  VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Badge}" DockPanel.Dock="Right"
                                                   VerticalAlignment="Center" FontSize="11"
                                                   Foreground="#9AA6B5" Margin="6,0,0,0"/>
                                        <TextBlock Text="{Binding Display}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>

                            <!-- ★ v1.6.2：按「已购课程 / 公开课」分组，小标题用灰字 -->
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" FontSize="11"
                                                       FontWeight="SemiBold" Foreground="#8494A8"
                                                       Margin="2,10,0,4"/>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                        </ListBox>

                        <DockPanel Grid.Row="3" Margin="0,8,0,0" LastChildFill="False">
                            <Button x:Name="BtnRefreshCamps" DockPanel.Dock="Left" Content="刷新"
                                    Style="{StaticResource ModernButtonStyle}"
                                    Click="BtnRefreshCamps_Click"/>
                            <TextBlock x:Name="LblCampHint" DockPanel.Dock="Left" Margin="10,0,0,0"
                                       Style="{StaticResource MutedTextStyle}" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </Grid>
                </Border>

                <!-- ── 右栏：课程列表 / 下载管理 / 运行日志 ── -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <!-- ★ v1.6.0：下载管理面板已合并进课程列表，这里只剩表格 + 日志 -->
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="140"/>
                    </Grid.RowDefinitions>

                    <!-- 课程列表 -->
                    <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" LastChildFill="False">
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                    <TextBlock Text="课程列表 ·" Style="{StaticResource SectionTitleStyle}"/>
                                    <ctrl:MarqueeControl x:Name="Marquee" Margin="4,0,0,0"/>
                                    <!-- ★ v1.6.0：视图切换 5 档。只过滤显示，**不影响下载范围判定**。 -->
                                    <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                                        <RadioButton x:Name="RbViewAll" GroupName="LessonView"
                                                     Style="{StaticResource ViewToggleStyle}" Content="全部"
                                                     Tag="all" IsChecked="True" Checked="RbView_Checked"/>
                                        <RadioButton x:Name="RbViewPending" GroupName="LessonView"
                                                     Style="{StaticResource ViewToggleStyle}" Content="待下载"
                                                     Tag="pending" Checked="RbView_Checked"/>
                                        <RadioButton x:Name="RbViewRunning" GroupName="LessonView"
                                                     Style="{StaticResource ViewToggleStyle}" Content="下载中"
                                                     Tag="running" Checked="RbView_Checked"/>
                                        <RadioButton x:Name="RbViewDone" GroupName="LessonView"
                                                     Style="{StaticResource ViewToggleStyle}" Content="已完成"
                                                     Tag="done" Checked="RbView_Checked"/>
                                        <RadioButton x:Name="RbViewFailed" GroupName="LessonView"
                                                     Style="{StaticResource ViewToggleStyle}" Content="失败"
                                                     Tag="failed" Checked="RbView_Checked"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <ComboBox x:Name="CmbQuality" Width="128" Margin="3,0,0,0"
                                              VerticalAlignment="Center"
                                              SelectionChanged="CmbQuality_SelectionChanged">
                                        <ComboBoxItem Content="最高画质 (1080p)" Tag="max"/>
                                        <ComboBoxItem Content="省流量 (720p)" Tag="720"/>
                                    </ComboBox>
                                    <Button x:Name="BtnRescan" Content="重新检测" Margin="3,0,0,0"
                                            Style="{StaticResource ModernButtonStyle}" Click="BtnRescan_Click"
                                            ToolTip="重新扫描下载目录，标记哪些课已经下过了"/>
                                    <!-- ★ v1.6.0：下载 / 暂停合并为一个状态切换按钮。
                                         空闲=「下载」(蓝) → 运行=「暂停」(琥珀) → 暂停=「继续」(琥珀)。
                                         文案与配色由代码按引擎队列状态切换，状态单一来源。 -->
                                    <Button x:Name="BtnRun" Content="下载" Margin="3,0,0,0"
                                            Style="{StaticResource PrimaryButtonStyle}" Click="BtnRun_Click"
                                            ToolTip="有选中行则只下选中的；没有选中则下当前视图里所有待下载的课"/>
                                    <Button x:Name="BtnResetRecords" Content="重置下载记录" Margin="3,0,0,0"
                                            Style="{StaticResource ModernButtonStyle}" Click="BtnResetRecords_Click"
                                            ToolTip="清空任务与下载历史、复位状态标记（不动磁盘上的成品文件）"/>
                                </StackPanel>
                            </DockPanel>

                            <Border Grid.Row="1" Margin="0,8,0,0" CornerRadius="8" Background="White"
                                    BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                                <!-- ★ v1.6.0：课程列表 + 下载管理合并为单表 8 列。
                                     SelectionMode=Extended：行选中接替了原来的勾选框
                                     （有选中 → 只下选中的；无选中 → 下当前视图全部待下载）。 -->
                                <ListView x:Name="LstLessons" BorderThickness="0" Background="Transparent"
                                          AlternationCount="2"
                                          ItemContainerStyle="{StaticResource LessonRowItemStyle}"
                                          SelectionMode="Extended"
                                          MouseDoubleClick="LstLessons_MouseDoubleClick">
                                    <ListView.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem x:Name="MiDownloadOne" Header="下载此课" Click="MiDownloadOne_Click"/>
                                            <MenuItem x:Name="MiRetry" Header="重试此课" Click="MiRetry_Click"/>
                                            <Separator/>
                                            <MenuItem x:Name="MiCopyName" Header="复制文件名" Click="MiCopyName_Click"/>
                                            <MenuItem x:Name="MiOpenFolder" Header="打开所在文件夹" Click="MiOpenFolder_Click"/>
                                            <MenuItem x:Name="MiDeleteFile" Header="删除成品文件" Click="MiDeleteFile_Click"/>
                                        </ContextMenu>
                                    </ListView.ContextMenu>
                                    <ListView.View>
                                        <GridView ColumnHeaderContainerStyle="{StaticResource GridHeaderStyle}">
                                            <!-- ColState：状态胶囊标签（浅底 + 深字 + 描边） -->
                                            <GridViewColumn Width="92" Header="状态">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{Binding StatePillBg, Converter={StaticResource HexBrushConverter}}"
                                                                BorderBrush="{Binding StatePillBorder, Converter={StaticResource HexBrushConverter}}"
                                                                BorderThickness="0.5" CornerRadius="9" Padding="9,2"
                                                                HorizontalAlignment="Left" VerticalAlignment="Center">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding StateWord}" Value="">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding StateWord}" FontSize="11"
                                                                       Foreground="{Binding StatePillFg, Converter={StaticResource HexBrushConverter}}"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <!-- ColTitle：课名（+ 历史行的「上次下载」标记） -->
                                            <GridViewColumn Width="330" Header="课程">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" ToolTip="{Binding ToolTip}">
                                                            <TextBlock Text="{Binding Title}"
                                                                       Foreground="{StaticResource TextDarkBrush}"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding HistoryHint}" Margin="6,0,0,0"
                                                                       FontSize="11" Foreground="#9AA6B5"
                                                                       VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <!-- ColCamp：所属营（单营时整列隐藏） -->
                                            <GridViewColumn Width="120" Header="所属营">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding CampName}" Foreground="#8494A8"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <!-- ColDur -->
                                            <GridViewColumn Width="66" Header="时长">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Duration}" HorizontalAlignment="Center"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <!-- ColSize -->
                                            <GridViewColumn Width="112" Header="大小">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Size}" Style="{StaticResource NumericCellStyle}"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <!-- ColSpeed -->
                                            <GridViewColumn Width="78" Header="速度">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Speed}" Style="{StaticResource NumericCellStyle}"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <!-- ColEta -->
                                            <GridViewColumn Width="78" Header="剩余">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Eta}" Style="{StaticResource NumericCellStyle}"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <!-- ColProgress：进度条（按状态着色）+ 百分比 -->
                                            <GridViewColumn Width="150" Header="进度">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Grid VerticalAlignment="Center">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="42"/>
                                                            </Grid.ColumnDefinitions>
                                                            <ProgressBar Value="{Binding Progress}"
                                                                         Style="{StaticResource CellProgressStyle}"
                                                                         Foreground="{Binding ProgressColor, Converter={StaticResource HexBrushConverter}}"
                                                                         ToolTip="{Binding ProgressTip}" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding ProgressText}"
                                                                       Margin="6,0,0,0" FontSize="11"
                                                                       Foreground="#5A6A80" VerticalAlignment="Center"
                                                                       HorizontalAlignment="Right"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </Border>

                            <!-- ★ v1.6.0：提示行挪到表格正下方（原来在最底部，被历史区挡住）。
                                 课表加载中 / 没选营 / 当前视图没课时，这里会说明原因。 -->
                            <TextBlock x:Name="LblLessonsHint" Grid.Row="2" Margin="2,6,0,0"
                                       Style="{StaticResource MutedTextStyle}" Text="选择左侧营查看课程"
                                       TextTrimming="CharacterEllipsis"/>

                            <!-- ★ v1.6.0：表尾汇总栏。原「下载管理」标题旁的全局汇总移到这里，
                                 否则这条信息会丢。左侧分类计数，右侧全局 ETA。 -->
                            <Border Grid.Row="3" Margin="0,4,0,0" CornerRadius="6"
                                    Background="#F4F6FA" Padding="10,5">
                                <DockPanel LastChildFill="False">
                                    <TextBlock x:Name="LblSummary" Style="{StaticResource MutedTextStyle}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock x:Name="LblTaskEta" DockPanel.Dock="Right"
                                               Foreground="{StaticResource PrimaryBrush}"
                                               FontWeight="SemiBold" VerticalAlignment="Center"
                                               Margin="14,0,0,0"/>
                                </DockPanel>
                            </Border>

                            <!-- 历史分隔带：上次下载过、但不在当前课表里的课 -->
                            <Border Grid.Row="4" Visibility="Collapsed" x:Name="HistoryBand"
                                    Background="#F4F6FA" Padding="10,3" Margin="0,8,0,0">
                                <TextBlock x:Name="LblHistoryBand" FontSize="11" Foreground="#7D8B9C"
                                           Text="上次下载 · 不在当前课表中（不可下载）"/>
                            </Border>

                            <ListView x:Name="LstHistory" Grid.Row="5" MaxHeight="120"
                                      BorderThickness="0" Background="Transparent"
                                      SelectionMode="Single"
                                      ItemContainerStyle="{StaticResource HistoryRowItemStyle}"
                                      Visibility="Collapsed">
                                <ListView.View>
                                    <GridView ColumnHeaderContainerStyle="{StaticResource HiddenHeaderStyle}">
                                        <GridViewColumn Width="92">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Background="{Binding StatePillBg, Converter={StaticResource HexBrushConverter}}"
                                                            BorderBrush="{Binding StatePillBorder, Converter={StaticResource HexBrushConverter}}"
                                                            BorderThickness="0.5" CornerRadius="9" Padding="9,2"
                                                            HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding StateWord}" FontSize="11"
                                                                   Foreground="{Binding StatePillFg, Converter={StaticResource HexBrushConverter}}"/>
                                                    </Border>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Width="330">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Title}" Foreground="#7D8B9C"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding ToolTip}"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Width="120">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding CampName}" Foreground="#9AA6B5"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Width="66">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Duration}" HorizontalAlignment="Center"
                                                               Foreground="#9AA6B5"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Width="112">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Size}" Style="{StaticResource NumericCellStyle}"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Width="78">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Speed}" Style="{StaticResource NumericCellStyle}"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Width="78">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Eta}" Style="{StaticResource NumericCellStyle}"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Width="150">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding ProgressText}" FontSize="11"
                                                               Foreground="#9AA6B5" HorizontalAlignment="Right"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>



                        </Grid>
                    </Border>

                    <!-- 运行日志 -->
                    <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" LastChildFill="False">
                                <TextBlock Text="运行日志" Style="{StaticResource SectionTitleStyle}"/>
                                <Button x:Name="BtnClearLog" DockPanel.Dock="Right" Content="清空日志"
                                        Style="{StaticResource ModernButtonStyle}" Click="BtnClearLog_Click"/>
                            </DockPanel>
                            <Border Grid.Row="1" Margin="0,6,0,0" CornerRadius="6"
                                    Background="{StaticResource LogBgBrush}">
                                <TextBox x:Name="TxtLog" Style="{StaticResource LogTextBoxStyle}"
                                         Background="Transparent" BorderThickness="0"/>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- ══════════════ 状态栏 ══════════════ -->
        <Border Grid.Row="2" Background="{StaticResource StatusBgBrush}" Padding="12,4">
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="StatusLabel" Text="就绪" Foreground="{StaticResource HeaderTextBrush}"/>
                <TextBlock x:Name="LblVersion" DockPanel.Dock="Right" Text="兴趣岛 · 1.5.1"
                           Foreground="{StaticResource MutedBrush}"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
