<?xml version="1.0" encoding="utf-8"?>
<!--
  ★ v1.6.3：NuGet 源配置。

  为什么需要这个文件：
  自包含发布（self-contained）要拉 runtime pack
  （Microsoft.NETCore.App.Runtime.win-x64 等，约 70 MB），必须联网。
  默认源在本机会被系统代理吞掉，restore 直接 NU1100 失败；
  显式声明 nuget.org 后全部拉取正常（2026-11-08 实测）。

  ★ CI 上同样受益：GitHub 的 Windows runner 走 nuget.org 是通的，
    但显式声明可以避免将来 NuGet 默认源策略变化导致的构建失败。

  ★ 注意：XML 注释里不能出现连续两个减号。
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
